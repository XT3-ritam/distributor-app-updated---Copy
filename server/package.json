{
  "name": "distributor-server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --enable-source-maps --import tsx src/index.ts",
