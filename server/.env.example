DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/distributor
PORT=3000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Users stay signed in on this device for one year unless they log out.
SESSION_TOKEN_TTL=365d
SETUP_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
GOOGLE_GEMINI_API_KEY=replace-with-your-google-gemini-api-key
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
UPLOAD_DIR=uploads
